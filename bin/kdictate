#!/usr/bin/env bash
set -euo pipefail
APP="${KDICTATE_APPDIR:-$HOME/.local/share/kdictate-cosmic}"
PY="$APP/venv/bin/python"
if [ ! -x "$PY" ]; then
  echo 'Verbatim is not installed. Extract the complete bundle and run bash install.sh.' >&2
  exit 127
fi
# config.env is read as data by Python, never evaluated as shell commands.
CUDA_PATH="$(find "$APP/venv/lib" -type d \( -path '*/nvidia/cublas/lib' -o -path '*/nvidia/cudnn/lib' \) -print 2>/dev/null | paste -sd: - || true)"
if [ -n "$CUDA_PATH" ]; then export LD_LIBRARY_PATH="$CUDA_PATH${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; fi
# Local optional layer shell uses one portable prefix, including Fedora lib64.
for root in "$APP/native/layer/lib" "$APP/native/layer/lib64" /usr/local/lib /usr/local/lib64; do
  if [ -d "$root/girepository-1.0" ]; then export GI_TYPELIB_PATH="$root/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"; fi
  if [ -d "$root" ]; then export LD_LIBRARY_PATH="$root${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; fi
done
if [ "${XDG_SESSION_TYPE:-}" = wayland ] || { [ -n "${WAYLAND_DISPLAY:-}" ] && [ "${XDG_SESSION_TYPE:-}" != x11 ]; }; then
  LS_LIB=''
  for candidate in "$APP/native/layer/lib/libgtk4-layer-shell.so.0" "$APP/native/layer/lib64/libgtk4-layer-shell.so.0"; do
    if [ -f "$candidate" ]; then LS_LIB="$candidate"; break; fi
  done
  if [ -z "$LS_LIB" ]; then LS_LIB="$(ldconfig -p 2>/dev/null | awk '/libgtk4-layer-shell.so/ && !found {print $NF; found=1}' || true)"; fi
  if [ -n "$LS_LIB" ]; then export LD_PRELOAD="$LS_LIB${LD_PRELOAD:+:$LD_PRELOAD}"; fi
fi
export KDICTATE_APPDIR="$APP"
if [ "$#" -eq 0 ]; then set -- toggle; fi
exec "$PY" "$APP/app/kdictate.py" "$@"
