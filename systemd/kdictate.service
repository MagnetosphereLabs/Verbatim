[Unit]
Description=Verbatim Local AI Dictation Daemon
Documentation=https://github.com/MagnetosphereLabs/Verbatim
After=graphical-session.target pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/kdictate daemon
Restart=always
RestartSec=2
KillMode=mixed
Environment=KDICTATE_APPDIR=%h/.local/share/kdictate-cosmic
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
